disableChannels[] = {{0,true,true},{1,true,true},{2,true,true}};    // Disabled text and voice for global, side, and command channels. Syntax: disableChannels[] = {{channelID<number>, disableChat<bool>, disableVoice<bool>}};
#include "config\Config_Community.hpp"
onLoadName = COMMUNITY_MISSION_NAME;    // Name im Ladebildschirm (zentral in config\Config_Community.hpp)
briefingName = COMMUNITY_MISSION_NAME;  // Name in Lobby und Serverliste (zentral in config\Config_Community.hpp)
overviewText = "$STR_MISC_overviewText";    // Text to be displayed below the overviewPicture on the mission selection screen when the mission is available to play.
unsafeCVL = 1; // Allows createVehicleLocal to be executed in Multiplayer
enableDebugConsole = 1; // Debug-Konsole nur fuer per #login eingeloggte Server-Admins (0 = aus, 2 = alle, nie 2 setzen)
//Ohne Lobby ins Spiel: Der Spieler bekommt automatisch einen freien Slot und ueberspringt die
//Rollenauswahl. Welcher Slot das ist, spielt keine Rolle mehr - CfgServer >> StartAsCivilian
//setzt jeden auf Zivilist, die Fraktion waehlt man im Spiel ueber die Telefon-App "Dienst".
joinUnassigned = 0;     // 0 = freien Slot automatisch zuweisen, 1 = Spieler bleibt unassigned
skipLobby = 1;          // Rollenauswahl ueberspringen
hostDoesNotSkipLobby = 1; // Beim Hosten (nicht dediziert) bleibt die Lobby, sonst kommt man nicht mehr ins Setup
#include "CfgRemoteExec.hpp"
#include "dialog\MasterHandler.hpp"
#include "config\Config_Master.hpp"
class CfgServer {
    DatabaseName = "altislife"; //Config name that'll be grep in the extdb-conf.ini. Default: [altislife]
    DebugMode = 0; //Enable many server/hc debugging logs. Default: 0 (1 = Enabled / 0 = Disabled)
    CallerCheckMode = 2; //Sicherheit: Absenderpruefung fuer Client-Anfragen an den Server. 0 = aus, 1 = nur protokollieren, 2 = protokollieren und blockieren. Log: [SECURITY]
    EconomyMode = 2; //Geld-Umbau (docs/ECONOMY_AUTHORITY.md): 0 = aus wie Altis Life 5.0, 1 = Schattenmodus (Server fuehrt Kontostaende mit, Transaktionslog, [ECONOMY]-Warnungen), 2 = Server entscheidet (Speicherungen des Clients aendern Geld nicht mehr)
    InventoryMode = 1; //Inventar-Umbau (docs/INVENTORY_AUTHORITY.md): 0 = aus wie Altis Life 5.0, 1 = Schattenmodus (Server fuehrt die virtuellen Inventare mit, [INVENTORY]-Warnungen), 2 = Server entscheidet (Zugaenge des Clients werden verworfen, Bestaende korrigiert) - erst umstellen, wenn im Log nichts mehr auftaucht
    StartAsCivilian = 1; //Dienst-System: Jeder startet als Zivilist, egal in welchem Slot ihn die Engine platziert hat (0 = Fraktion nach Slot wie frueher)
    HeadlessSupport = 0; //Enable/Disable Headless client support. Default: 1 (1 = Enabled / 0 = Disabled)
    /*
    Enabled: When HeadlessSupport is set to 1 (enabled), the server will run without fault when no Headless Client is connected. However, it will support the Headless Client if you choose to connect one.
    Disabled: If HeadlessSupport is set to 0 (disabled), the connection of a Headless Client will make no difference. This option will increase server performance a TINY but negligible amount.
    */
};
