#
# NOTE! Don't add files that are generated in specific
# subdirectories here. Add them in the ".gitignore" file
# in that subdirectory instead.
#
# NOTE! Please use 'git ls-files -i --exclude-standard'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.
#
# Normal rules
#
.*
*~
*.zip
*.rar
*.bak

#
# Windows Files
#
*.dll
*.bat
*.exe
Thumbs.db

#
# Linux Files
#
*.so
*.sh
.fuse_hidden*
.Trash-*

#
# OSX Files
#
.DS_Store
.AppleDouble
.LSOverride

#
# Bohemia Packed Files
#
*.pbo
*.xbo
*.ebo
*.ifa

#
# IntelliJ IDEA Files
#
.idea/
*.iml

#
# Local server and development files (never commit credentials or builds)
#
/@*/
/mods/
/userconfig/
/*.py
/*.sql
!/altislife.sql
extdb3-conf.ini
LOCAL_SERVER.md
*.lnk
*.ps1
*.rpt
*.mdmp
*.log
